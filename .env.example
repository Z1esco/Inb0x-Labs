# Browser-safe application configuration. Set NEXT_PUBLIC_APP_URL explicitly
# for every Vercel environment; do not leave localhost in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Accepts a current Supabase publishable key or legacy anon key. Browser-safe
# only because database access is still constrained by grants and RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Use a newly rotated secret/service-role key;
# never prefix it with NEXT_PUBLIC_ and never reuse a key exposed in chat.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated Gmail authorization (separate from application sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# At least 32 random characters; used to hash single-use OAuth state
OAUTH_STATE_SECRET=
# Base64-encoded 32-byte AES-256-GCM key
TOKEN_ENCRYPTION_KEY=

# OpenAI server configuration; key and model are required only when using real analysis
OPENAI_API_KEY=
# Set a Responses Structured Outputs-capable model available to your API project
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# Credential-free deterministic mode. Real application Auth requires the three
# Supabase variables above; Gmail and OpenAI validate their own configuration.
DEMO_MODE=true

# Cost and retention limits
ANALYSIS_DAILY_LIMIT=20
ANALYSIS_BATCH_LIMIT=10
REPLY_DAILY_LIMIT=20
GMAIL_LOOKBACK_DAYS=30
GMAIL_MAX_THREADS=50
THREAD_MAX_CHARACTERS=12000
DATA_RETENTION_HOURS=24
